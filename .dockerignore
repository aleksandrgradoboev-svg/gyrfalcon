# Артефакты сборки хоста: в контейнере они не годятся (другая платформа) и
# весят больше всего остального контекста вместе взятого.
target/

# История и служебное — на сборку не влияют.
.git/
.github/
docs/
*.md

# Индексы конфигураций и выгрузки: гигабайты чужого кода, которым в образе
# делать нечего. index/ и src-1c/ названы поимённо — это каталоги умолчаний
# compose, и они появляются прямо в корне репозитория.
/index/
/src-1c/
*.db

# А словарь семантики — едет внутрь. Он отслеживается в git (решение
# владельца 28.08.2026), весит 40 МБ и нужен КАЖДОЙ сборке индекса: без него
# `find` остаётся без семантического сигнала. Монтировать его к каждому
# запуску значило бы требовать от человека знать, где он лежит, — при том
# что он лежит в этом же репозитории.
!data/dictionary-all-configs.db

# Тулчейн задаёт тег базового образа. Оставить файл значило бы заставить
# rustup выкачивать вторую копию stable вместе с rustfmt и clippy —
# компонентами, которые сборке не нужны вовсе.
rust-toolchain.toml

# --- Rust ---
/target/
**/*.rs.bk
*.pdb

# --- индексы и данные (никогда не в репозиторий) ---
# Исключение: словарь семантики (data/dictionary-all-configs.db, 36 МБ) едет
# в репозиторий сознательно — решение владельца 28.08.2026. Собранные индексы
# конфигураций (сотни МБ, чужой код внутри) по-прежнему не едут.
/data/*
!/data/dictionary-all-configs.db
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- исходники 1С: чужой код, коммерческая тайна ---
/fixtures/configs/
*.cf
*.cfe
*.epf
*.erf
*.dt

# --- секреты ---
# Узко: только файлы С токенами доступа, а не всё со словом token в имени.
# Прежнее `*token*` съело crates/gyrfalcon-parser/src/tokens.rs (модуль
# токенизации имён) — он не попал в первый пуш вехи 4, CI упал на
# «failed to resolve mod tokens», локально при этом всё собиралось.
*token.txt
*token.json
*_token*
*-token*
.token
*.pem
*.key
.env
.env.*
!.env.example

# --- вендорские базы справки (большие, собираются отдельно) ---
*.hbk
/help/

# --- инструменты и среда ---
/.idea/
/.vscode/
*.swp
.DS_Store
Thumbs.db

# --- замеры (сырьё большое, в репозиторий едут только сводки) ---
/benchmarks/raw/

# Окружение для офлайн-построения словаря (tools/build-dictionary.py).
# Ставится по инструкции в шапке скрипта, в репозиторий не едет: 2,5 ГБ
# и машинно-зависимые пути.
.venv-embed/

# План работ живёт вне репозитория (решение владельца 30.08.2026).
# Он про наши вехи, риски и сроки — постороннему читателю не нужен,
# а внутреннюю кухню показывает целиком.
docs/roadmap.md

# Замеры со сверкой против других инструментов живут вне репозитория
# (решение 30.08.2026). Числа о НАС самих остаются в README и в коде;
# сравнения — внутренняя работа, и публичному читателю они говорят
# больше о чужих проектах, чем о нашем.
docs/benchmarks/
docs/acceptance.md

# Кэш Python — оснастка, не исходники.
__pycache__/
*.pyc
tools/acceptance/last-run.json

# Каталоги умолчаний compose: их создаёт первый `docker compose up`, и
# содержимое — чужие индексы и выгрузки, а не исходники проекта.
/index/
/src-1c/
